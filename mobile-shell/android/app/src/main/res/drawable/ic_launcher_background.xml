<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的背景层：品牌主色 #465FFF（与 frontend/public/favicon.svg 的
     rect fill 一致，也就是顶栏左上角那个标志）。
     原来这里是 Capacitor 模板的 #26A69A 青绿色 —— 那是脚手架自带的，
     跟我们的品牌没关系，装机后显示的是模板图标（用户截图确认）。
     整块铺满 108×108：自适应图标的外形（圆角/圆形）由系统按厂商样式裁切，
     这里不需要自己画圆角。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <path
        android:fillColor="#465FFF"
        android:pathData="M0,0h108v108h-108z" />
</vector>
