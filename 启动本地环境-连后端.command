#!/bin/bash
# ============================================================================
#  一键启动「连真实后端」的本地全栈（macOS，双击即可运行）
#
#  与「启动本地环境.command」共用同一套启动/自检逻辑，只是把前端模式
#  从 demo 换成 backend：
#      主后端   :8000   真实 SQLite / 检索 / 预警 / 案例 / 管理端
#      侧车后端 :8001   AI 对话 / 知识图谱 / 推理 / 推送（Neo4j 可选）
#      前端     :5173   --mode backend + VITE_STRICT_BACKEND=1
#
#  严格模式的含义：接口失败会直接报错，**不会**静默退回演示数据。
#  所以打开页面看到的每一条记录都来自 8000/8001。
#
#  账号：xiaoyu / 123456      管理端：adminer / admin 或 admin / admin123
# ============================================================================

set -u
cd "$(dirname "$0")" || exit 1
MODE=backend exec ./启动本地环境.command
