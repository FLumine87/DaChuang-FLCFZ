# ============================================================
# 生产环境变量（GitHub Pages 部署用）
# 实际值由 GitHub Actions 构建时通过环境变量注入（VITE_* 前缀会被 Vite 读取并
# 优先于本文件），本文件为占位示例，供本地 preview 或手动构建参考。
# ============================================================

# 后端 API 地址（Cloudflare Worker 域名）
VITE_API_BASE_URL=https://mental-screening-api.787249795.workers.dev

# 生产环境默认走真实后端；如需纯静态演示可改为 true（走内置 Mock 数据）
VITE_USE_MOCK=false

# GitHub Pages 子路径 base（本仓库部署地址为 https://flumine87.github.io/DaChuang-FLCFZ/）
VITE_BASE_PATH=/DaChuang-FLCFZ/
