# ============================================================
# Capacitor（安卓 APK）专用构建环境 —— 离线演示版
#   vite build --mode capacitor --outDir dist-app
#
# 与 .env.production 的关键差别：
#
# 1. VITE_BASE_PATH=/
#    Capacitor 的 WebView 把 android/app/src/main/assets/public/ 挂在
#    https://localhost 的【根】上，所以资源必须用根路径引用。
#    .env.production 里是 /DaChuang-FLCFZ/（GitHub Pages 子路径），
#    装进 APK 后 /DaChuang-FLCFZ/assets/*.js 会 404 —— 打开就是白屏。
#
# 2. VITE_OFFLINE=1
#    显式声明"这个包没有后端"。
#    作用：让 api 那一组接口（陪伴对话 / 知识图谱 / 推理 / 推送 / 问询）
#    走本机实现，而不是去打一个不存在的地址、失败后再落到页面里写死的兜底文案。
#    为什么必须显式写：这几个接口原先靠 `import.meta.env.DEV` 推断有没有后端，
#    但用自定义 mode（--mode capacitor）构建时该值不可靠，实测离线包也走了在线分支。
#
# 3. VITE_USE_MOCK=true
#    主数据层（登录 / 量表 / 筛查记录 / 检索 / 预警 / 案例 / 管理端）走内置演示数据。
#
# 注意：本文件必须是合法 UTF-8，且不要把这些键写进注释里 ——
#      之前有一次用脚本替换时误伤注释行，导致整份 env 解析异常、开关失效。
# ============================================================

VITE_BASE_PATH=/
VITE_USE_MOCK=true
VITE_OFFLINE=1
VITE_API_BASE_URL=
