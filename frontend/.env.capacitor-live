# ============================================================
# Capacitor APK —— **连后端**版（在线功能可用）
#   npm run build:app:live
#
# 与 .env.capacitor（离线演示版）的差别：把两个后端地址填成**手机上能访问到**
# 的绝对地址，于是 App 里的陪伴对话 / 知识检索 / 知识图谱 / 推送都能真的工作。
#
# ⚠ 两个前提：
#   1. 手机和电脑要连**同一个 WiFi**（下面用的是电脑的局域网 IP）
#   2. 电脑上这两个服务要开着：
#        backend        → 8000   （cd backend && ./venv/bin/python -m app.main）
#        personal-backend → 8001 （cd personal-backend && venv/bin/python -m uvicorn app.main:app --port 8001）
#
# ⚠ 电脑换网络后局域网 IP 会变（当前是 ��。
#   重新取：ipconfig getifaddr en0   —— 改完这两行重新构建即可。
#
# 想让别人在任何网络下都能用，就得把后端部署到公网（见 .github/workflows/
# deploy-backend.yml），再把这里换成那个域名、并把前端构建走 https。
# ============================================================

VITE_BASE_PATH=/
# 走真实后端，不用内置演示数据
VITE_USE_MOCK=false
# 主后端（筛查 / 检索 / 预警 / 案例）
VITE_API_BASE_URL=http://10.253.57.151:8000
# 侧车后端（陪伴对话 / 知识图谱 / 推送）—— 打包版没有 Vite 代理，必须显式给
VITE_PERSONAL_API_BASE=http://10.253.57.151:8001
