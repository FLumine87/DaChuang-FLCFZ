# ============================================================
# 项目根 .gitignore（全局兜底）
# backend/ 与 frontend/ 下另有各自的 .gitignore（优先级更高），
# 此处覆盖全仓库通用的忽略项。
# ============================================================

# ---- Node / 前端 ----
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python / 后端 ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/

# ---- 数据库（默认忽略；检索种子库例外，见 backend/.gitignore）----
*.db
*.db-journal
*.sqlite
*.sqlite3
backup_*.db

# ---- 上传文件 ----
uploads/
*.wav
*.mp3
*.m4a
*.ogg
*.jpg
*.jpeg
*.png
*.gif
*.webp

# ---- 离线资产（真实数据集 / 模型权重）：一律不入库，各自本地准备 ----
# 真实数据集体积大且带使用条款，绝不随仓库分发；其派生产物（如 real_corpus.db）
# 也由 scripts/build_real_corpus.py 在本地生成，且 media_path 为绝对路径，换机器即失效。
# 仅保留目录说明文件，方便下载者知道该放什么。
offline/*
!offline/datasets/
offline/datasets/*
!offline/datasets/README.md

# ---- 环境变量（保留 .env.example / .env.production 示例）----
.env
.env.local
.env.*.local

# ---- Cloudflare Wrangler ----
.wrangler/

# ---- 日志 ----
*.log
logs/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
