# ============================================================
# 项目根 .gitignore（全局兜底）
# backend/ 与 frontend/ 下另有各自的 .gitignore（优先级更高），
# 此处覆盖全仓库通用的忽略项。
# ============================================================

# ---- Node / 前端 ----
node_modules/
frontend/dist/
# 单文件打包产物（vite.singlefile.config.ts 的输出，用于"双击打开/发到手机上"）。
# 是生成物不是源码：每次构建都变，进库只制造噪音。
# 配置本身（vite.singlefile.config.ts）要跟踪，产物不要。
frontend/dist-single/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---- Python / 后端 ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/

# ---- 数据库（默认忽略；检索种子库例外，见 backend/.gitignore）----
*.db
*.db-journal
*.sqlite
*.sqlite3
backup_*.db

# ---- 弱监督桥接的模型状态（语料衍生物，本地重建）----
# 桥接的投影矩阵 W 与单元码依赖于本地 real_corpus.db（不入库），
# 换机器后语料不同、模型即失效；由 scripts/build_bridges.py 一键重建
# （20~70 秒），没有必要把十几 MB 的二进制衍生品提交进仓库。
backend/data/hashing/bridge_*_state.json

# ---- AI 助手工作区（个人笔记与实验记忆，不属于项目代码）----
.workbuddy/

# ---- 上传文件 ----
uploads/
*.wav
*.mp3
*.m4a
*.ogg
*.jpg
*.jpeg
*.png
*.gif
*.webp
# 首屏插画是源码资产，需要入库（其余截图/生成图仍忽略）
!frontend/src/assets/hero-calm-*.webp

# ---- 离线资产（真实数据集 / 模型权重）：一律不入库，各自本地准备 ----
# 真实数据集体积大且带使用条款，绝不随仓库分发；其派生产物（如 real_corpus.db）
# 也由 scripts/build_real_corpus.py 在本地生成，且 media_path 为绝对路径，换机器即失效。
# 仅保留目录说明文件，方便下载者知道该放什么。
offline/*
!offline/datasets/
offline/datasets/*
!offline/datasets/README.md

# ---- 根目录 data/：本地数据集参考资料 ----
# 这是开发时放在仓库根下的数据集素材（AVDD-TCMI / EATD / IEMOCAP / Reddit 等），
# 约 28 GB，代码不读取它（引擎读的是 offline/datasets），纯粹是本地参考。
# 不进库：体积远超 GitHub 单文件/仓库限制，且数据集本身带使用条款。
data/

# ---- 环境变量（保留 .env.example / .env.production 示例）----
.env
.env.local
.env.*.local

# ---- Cloudflare Wrangler ----
.wrangler/

# ---- 日志 ----
*.log
logs/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Windows 快捷方式 ----
# .lnk 内含绝对路径，随机器不同（同一仓库的不同克隆路径也可能不同）。
# 不入库，避免一次 pull 把另一个克隆的快捷方式覆盖成别的目录。
*.lnk

# ---- 本地工具链二进制（uv 等，约 69MB）----
# 不入库：CI 用 astral-sh/setup-uv 自行安装；本地开发者用 venv / npm 即可。
.tools/

# ---- 哈希引擎运行状态（构建产物，数 MB 且随机器/语料变化）----
# real_corpus.db 已被上面的 *.db 覆盖，这里补上状态文件。
backend/data/hashing/hashing_state.json

# git bundle 快照（本地产物，不入库）
.bundles/

# 本地 Node 运行时（为跑 dev server 下载，不入库）
.tools/
.shots/

# ---- 本地产物 / 临时目录（不入库）----
# 这三个都是本机生成的工作产物，体积大且与提交无关：
#   distribution/ 是给竞赛提交用的打包（含 65MB 代码归档 zip）
#   output/       是导出 PDF 等中间产物
#   tmp/          是临时脚本
distribution/
output/
tmp/

# ---- AI 助手工作区（**绝不可入库**）----
# .workbuddy/ 是本地 AI 工具的工作目录，不是项目代码。这里面有：
#   · memory/*.md  开发过程日志，正文里**明文记录过本机 API Key 与演示账号密码**
#   · tmp/         一次性脚本与中间文本
# 入库等于把密钥连同开发细节一起发给所有人。整目录排除，不做例外。
.workbuddy/

# ---- 本机验证残留（不入库）----
# 验证脚本的临时产物与截图。当前图片已被上面的 *.png 规则忽略，
# 但目录里一旦混入 json/txt 就会被提交，所以按目录整体排除更稳。
.verify-tmp/
_shots/

# 开发过程截图归档：目录本身要入库（只放各批次的 索引.md 与 README），
# 图片文件已被上面的 *.png/*.jpg 全局规则忽略，因此这里不再整目录忽略。
# docs/screenshots/

# 本机专用脚本：内含本机绝对路径 / 用于把 token 写进本机钥匙串，不入库
存储token.command

# 设计稿演示工程的依赖，不入库
design/home-react/node_modules/
.trial-data/

# ---- C++ 作业（Lab2/）的编译产物：不入库 ----
# VS Code 的构建任务会把可执行文件和调试符号生成在源码旁边，
# 每次 F5 都重新生成，入库只制造噪音。源文件 *.cpp 仍然正常跟踪。
*.dSYM/
Lab2/Lab2_?
