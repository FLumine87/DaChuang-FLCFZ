# 生产环境变量模板：复制为 .env.prod 后填写，切勿提交到仓库
#   cp .env.prod.example .env.prod && nano .env.prod
# 生成随机密钥：openssl rand -base64 48

# 对外端口（服务器安全组/防火墙放行该端口即可；80 被占用时改成 8080 等）
PUBLIC_PORT=80

# 两端必须完全一致：主后端签发 JWT、个人端校验 JWT
SECRET_KEY=请替换为随机长字符串

# 两端必须完全一致：主后端与个人端之间的私有同步签名
STEWARD_SYNC_SECRET=请替换为另一条随机长字符串

# Neo4j 初始密码：首次启动写入数据卷，之后改这里不会生效（需删卷重建）
NEO4J_PASSWORD=请替换为强密码

# ---- 主业务后端：RAG / 文档分析 ----
ENABLE_MOCK_ENGINES=False
RAG_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=请填写
DEEPSEEK_MODEL=deepseek-chat

# ---- 个人端 AI 服务：画像、陪伴对话、AI 线索提取 ----
LLM_BASE_URL=https://api.longcat.chat/openai/v1
LLM_API_KEY=请填写
LLM_MODEL=LongCat-2.0
LLM_TIMEOUT=60
# 档案汇总单独放宽（秒），长记录生成需要时间
STEWARD_LLM_TIMEOUT=180
LLM_VERIFY_SSL=True

# 跨模态哈希：默认走真实特征；没有同步语料时请保持 False，首次使用会按需构建
HASHING_USE_MOCK=False
