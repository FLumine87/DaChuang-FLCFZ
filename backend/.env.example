# 后端环境变量示例（复制为 .env 后填写真实值）
# pydantic-settings 会自动读取本文件，覆盖 config.py 中的默认值。

# 智谱 AI（RAG_PROVIDER=zhipu 且 ENABLE_MOCK_ENGINES=False 时需要）
ZHIPUAI_API_KEY=your-zhipu-api-key-here

# RAG 引擎提供方：deepseek(默认) | zhipu
# 注意：仅当 ENABLE_MOCK_ENGINES=False 时才生效；True 时强制 Mock，无需任何密钥。
RAG_PROVIDER=deepseek

# DeepSeek（真实 RAG 生成报告；检索为本地 TF-IDF，无需向量库/embedding 接口）
# 把你的 DeepSeek API Key 填到这里即可启用真实报告；留空则自动降级为 Mock 报告。
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7

# JWT 签名密钥（生产环境务必改为随机长字符串）
SECRET_KEY=change-me-to-a-random-secret

# 令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 是否启用 Mock 引擎（True=全部用 Mock，无需任何外部密钥即可演示；False=启用真实引擎）
ENABLE_MOCK_ENGINES=True

# 动态跨模态哈希引擎是否仍走 Mock（True 兼容旧演示；False 使用真实 CMFH+LSH 引擎）
HASHING_USE_MOCK=False
