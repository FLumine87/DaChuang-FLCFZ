# 复制为 .env 后使用（详细说明见根目录 README-个人端部署指南.md）

# 业务数据库（预警记录等）
DATABASE_URL=sqlite:///./mental_screening.db

# Neo4j（个人知识图谱 + 领域知识图谱，Docker: docker run -d --name personal-kg-neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/your_password neo4j:5-community）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# LLM API（任一 OpenAI 兼容接口，三选一示例）：
#   DeepSeek: https://api.deepseek.com/v1            模型 deepseek-chat
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   OpenAI:   https://api.openai.com/v1              模型 gpt-4o-mini
# 注意：火山引擎方舟必须使用 ep- 开头的接入点 ID 或平台有效模型 ID，否则 404
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
# 校园网/代理环境 SSL 校验失败（CERTIFICATE_VERIFY_FAILED）时设为 False
LLM_VERIFY_SSL=True

# 无 LLM_API_KEY 时设为 True，自动使用内置 Mock 抽取器 + 模板报告，便于离线开发
ENABLE_MOCK_ENGINES=False

# 可选：自建 NetEaseCloudMusicApi 地址，如 http://localhost:3000（留空用内置种子兜底）
MUSIC_API_URL=
# 可选：是否用 LLM 生成推荐语（失败回退模板）
ENABLE_LLM_CONTENT=True

# 可选：定时日常问询 Agent（APScheduler，每天触发一次）
ENABLE_DAILY_CHECKIN=True
DAILY_CHECKIN_HOUR=20
DAILY_CHECKIN_MINUTE=0
